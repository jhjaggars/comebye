[Unit]
Description=herdr phone web app
Documentation=https://herdr.dev/docs/socket-api/
After=network.target

[Service]
ExecStart=%h/.local/bin/herdr-phone -addr 127.0.0.1:8741
# Web Push is on by default; its VAPID key and subscriptions live in
# ~/.local/state/herdr-phone (override with -state-dir). The optional ntfy
# fallback is enabled with -ntfy-topic / HERDRPHONE_NTFY_TOPIC.
# HERDRPHONE_TS_ALLOW_LOGIN, HERDRPHONE_PUSH_SUBJECT and HERDRPHONE_NTFY_*
# live in this optional file; see README. For several machines, the hub's
# file also sets HERDRPHONE_PEERS and the peers' set HERDRPHONE_PUSH=false
# (README, "Multiple hosts").
EnvironmentFile=-%h/.config/herdr-phone/env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
