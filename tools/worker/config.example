# comebye-worker config. Copy to ~/.config/comebye-worker/config.
# KEY=VALUE, one per line. No secrets here: the Tailscale OAuth client lives
# in its own mode-0600 file (ts_oauth_file).

# --- required
# provider=gcp                    # gcp (default) or aws

# GCP:
project=my-gcp-project
zone=us-central1-a
# AWS (instead of the two lines above; credentials are your AWS CLI profile's):
# provider=aws
# aws_region=us-east-1
# aws_az=us-east-1a
# aws_profile=work                # optional: a named profile of your AWS CLI
# aws_spot=true                   # optional: spot pricing (see docs/workers.md); default false
# Your workstation's public IPv4 as a single /32: the only address that may reach tcp:22.
ssh_source_cidr=203.0.113.7/32
# The Tailscale login that owns the hub device (the worker admits the hub's requests as it).
ts_allow_login=you@example.com
# The hub's Serve URL as you reach it (version lookup, peer removal) ...
hub_url=https://hub.your-tailnet.ts.net
# ... what becomes COMEBYE_HUB on the worker: the hub's Serve URL again (the app-capability
# path, recommended), or the legacy peer listener, http://hub.your-tailnet.ts.net:8742.
hub_peer_url=https://hub.your-tailnet.ts.net

# --- defaults, shown for reference
# machine_type=e2-standard-4      # aws default: t3.xlarge (Arm types are refused)
# boot_disk_gb=20
# data_disk_gb=50
# disk_type=pd-balanced           # aws default: gp3
# image_project=debian-cloud      # gcp
# image_family=debian-12          # gcp
# image_id=ami-...                # aws: instead of the Debian 12 SSM parameter
# vpc_range=10.77.0.0/16          # aws; subnet_range must lie inside it
# network=comebye-worker
# subnet_range=10.77.0.0/24
# ssh_user=worker
# idle_minutes=120
# max_run_duration=24h        # gcp: platform cap; aws: advisory guest timer; empty disables
# tag=tag:worker
# ts_oauth_file=~/.config/comebye-worker/tailscale-oauth
# ts_authkey_file=~/.config/comebye-worker/authkey   # hand-minted single-use key; deleted after use
# hub_version=v0.3.0          # pin instead of asking the hub
# herdr_install_url=https://herdr.dev/install.sh
# herdr_install_sha256=       # pin the install script (recommended)
# releases_url=https://github.com/jhjaggars/comebye/releases
