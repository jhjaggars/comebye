# comebye-worker config. Copy to ~/.config/comebye-worker/config.
# KEY=VALUE, one per line. No secrets here: the Tailscale OAuth client lives
# in its own mode-0600 file (ts_oauth_file).

# --- required
# provider=gcp                    # gcp (default), aws or openshell

# GCP:
project=my-gcp-project
zone=us-central1-a
# AWS (instead of the two lines above; credentials are your AWS CLI profile's):
# provider=aws
# aws_region=us-east-1
# aws_az=us-east-1a
# aws_profile=work                # optional: a named profile of your AWS CLI
# aws_spot=true                   # optional: spot pricing (see docs/workers.md); default false
# Your workstation's public IPv4 as a single /32: the only address that may reach tcp:22.
ssh_source_cidr=203.0.113.7/32
# The Tailscale login that owns the hub device (the worker admits the hub's requests as it).
ts_allow_login=you@example.com
# The hub's Serve URL as you reach it (version lookup, peer removal) ...
hub_url=https://hub.your-tailnet.ts.net
# ... what becomes COMEBYE_HUB on the worker: the hub's Serve URL again (the worker is
# admitted by its tag's app capability).
hub_peer_url=https://hub.your-tailnet.ts.net

# --- defaults, shown for reference
# machine_type=e2-standard-4      # aws default: t3.xlarge (Arm types are refused)
# boot_disk_gb=20
# data_disk_gb=50
# disk_type=pd-balanced           # aws default: gp3
# image_project=debian-cloud      # gcp
# image_family=debian-12          # gcp
# image_id=ami-...                # aws: instead of the Debian 12 SSM parameter
# vpc_range=10.77.0.0/16          # aws; subnet_range must lie inside it
# network=comebye-worker
# subnet_range=10.77.0.0/24
# ssh_user=worker
# idle_minutes=120
# max_run_duration=24h        # gcp: platform cap; aws: advisory guest timer; empty disables
# tag=tag:worker
# ts_oauth_file=~/.config/comebye-worker/tailscale-oauth
# ts_authkey_file=~/.config/comebye-worker/authkey   # hand-minted single-use key; deleted after use
# hub_version=v0.3.0          # pin instead of asking the hub
# herdr_install_url=https://herdr.dev/install.sh
# herdr_install_sha256=       # pin the install script (recommended)
# releases_url=https://github.com/jhjaggars/comebye/releases

# The transcript archive's settings (COMEBYE_ARCHIVE_*), the file the archive timer reads.
# `worker archive` and `destroy` upload through it; destroy refuses if it cannot.
# archive_env=~/.config/comebye/archive.env

# Agent harnesses installed on the worker, never signed in: pi (default), claude, codex.
# agents=pi
# pi is pinned; bump it on purpose.
# pi_version=1.5.0

# LLM gateway (LiteLLM on the tailnet). Off unless llm_gateway_url is set. Each worker then
# gets its OWN virtual key (alias worker-NAME) with the limits below, delivered over ssh
# stdin into pi's auth.json (mode 600), and deleted again by destroy. The provisioning key
# (key-management routes only) stays on this machine, mode 600.
# llm_gateway_url=https://llm.your-tailnet.ts.net
# llm_provisioner_key_file=~/.config/comebye-worker/llm-provisioner-key
# llm_models=rits/zai-org/glm-5-3          # comma separated; the key can use only these
# llm_max_budget=5                         # USD per budget period
# llm_budget_duration=30d                 # the budget resets this often; the key itself never expires
# llm_rpm=30


# OpenShell sandboxes (provider=openshell, instead of the gcp/aws settings above; project, zone and
# ssh_source_cidr are not needed). The sandbox is a worker on the OpenShell gateway's Kubernetes driver.
# The gateway login is the openshell CLI's own (`openshell gateway login NAME`); nothing secret is here.
# provider=openshell
# openshell_gateway=homelab                  # a gateway registered with the CLI; or openshell_endpoint=https://...
# openshell_workspace=openshell-sandboxes    # required; a gateway can refuse "default"
# sandbox_image=registry.example/comebye-sandbox:{version}   # {version} = the hub's release
# sandbox_policy=~/.config/comebye-worker/sandbox-policy.yaml   # REQUIRED: render-policy.sh output from the image's template
# sandbox_providers=anthropic-claude,github-push   # gateway credential providers, made once by an admin
# sandbox_cpu=2
# sandbox_memory=6Gi
# idle_minutes=120                           # the init exits (sandbox Completed) after this long idle
# openshell_bin=openshell                    # the CLI to run

# Tailnet key (all providers). Defaults suit real workers. ts_key_ephemeral=true makes the node vanish
# from the tailnet soon after it goes offline: for tests only.
# ts_key_ephemeral=false
# ts_key_minutes=10                          # 1..60
