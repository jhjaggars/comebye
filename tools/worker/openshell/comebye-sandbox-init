#!/bin/bash
# Main process of a comebye worker sandbox (OpenShell, Kubernetes driver). Runs as
# the sandbox user, no systemd, no root, no capabilities: a small supervisor that
# keeps the stack up and, after SBX_IDLE_MINUTES with nothing working, exits 0 so the
# sandbox goes to Completed (the gateway keeps it; `sandbox start` brings it back).
#
# Contract with the provisioner (tools/worker): see README.md in this directory.
#   $HOME/.config/comebye/env   KEY=VALUE lines written over `sandbox exec` stdin
#   tailscale up                run by the provisioner (auth key over stdin), not here
set -u
export HOME=${HOME:-/sandbox}
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"   # an upgraded comebye in ~/.local/bin wins
S=$HOME/.ts; C=$HOME/.config/comebye; ENVF=${SBX_ENV_FILE:-$C/env}; L=${SBX_LOG_DIR:-/tmp}
mkdir -p "$S" "$C" "$HOME/code" "$HOME/worktrees" "$HOME/.local/state/comebye" "$HOME/.local/bin"
log() { echo "[$(date -Is)] init: $*" >>"$L/init.log"; echo "init: $*"; }

# A stop/start keeps /sandbox but nothing is running: drop sockets the last run left.
rm -f "$HOME/.config/herdr/herdr.sock" "$HOME"/.config/herdr/*.pid "$S/tailscaled.sock"

# The sandbox only reaches Completed when EVERY process is gone (the supervisor, pid 1, waits
# for them), and the keep loops outlive this script. So on any exit, kill the whole tree,
# parents before children (a killed child would be restarted by its loop).
kill_tree() { local k kids; kids=$(pgrep -P "$1" 2>/dev/null); kill "$1" 2>/dev/null; for k in $kids; do kill_tree "$k"; done; }
reap() { local k; for k in $(pgrep -P $$ 2>/dev/null); do kill_tree "$k"; done; }
trap reap EXIT
trap 'exit 143' TERM INT

keep() {  # keep NAME CMD...: restart on exit, 3 s apart
  local n=$1; shift
  ( while :; do "$@" >>"$L/$n.log" 2>&1 </dev/null; echo "[$(date -Is)] $n exited $?, restarting" >>"$L/$n.log"; sleep 3; done ) &
}

# ---- tinyproxy: the only way tailscaled reaches the internet. OpenShell denies
# IP-literal TCP and tailscaled dials DERP relays by IP, so tailscaled is pointed at
# this CONNECT proxy, which dials by hostname. The policy lets only tinyproxy and
# tailscaled reach Tailscale hosts, so this proxy is worth nothing to anything else.
cat >"$S/tinyproxy.conf" <<C2
Port 3128
Listen 127.0.0.1
Timeout 600
PidFile "$L/tinyproxy.pid"
LogFile "$L/tinyproxy.log"
MaxClients 64
ConnectPort 443
C2
keep tinyproxy tinyproxy -d -c "$S/tinyproxy.conf"

# ---- tailscaled, userspace networking: no /dev/net/tun, no capabilities.
# A pod has eth0, so a stock tailscaled works. The test-named knob below is set ONLY
# when there is no default route (podman driver: lo only), and that is a dead end anyway
# (magicsock never dials DERP); it exists so a podman sandbox can at least register.
TSKNOB=""; awk '$2=="00000000"{f=1} END{exit !f}' /proc/net/route || TSKNOB="TS_ASSUME_NETWORK_UP_FOR_TEST=1"
# --statedir (not --state): `tailscale serve` certificates need TailscaleVarRoot.
# SOCKS5 on 1055: how processes here reach tailnet hosts such as the hub.
keep tailscaled env $TSKNOB HTTPS_PROXY=http://127.0.0.1:3128 HTTP_PROXY=http://127.0.0.1:3128 \
  tailscaled --tun=userspace-networking --statedir="$S" --socket="$S/tailscaled.sock" --port=0 --socks5-server=127.0.0.1:1055

# ---- herdr (PTYs, agent state) and the agents' integrations.
keep herdr herdr server
for _ in $(seq 1 30); do [ -S "$HOME/.config/herdr/herdr.sock" ] && break; sleep 1; done
for spec in pi:.pi/agent/extensions claude:.claude; do
  mkdir -p "$HOME/${spec#*:}"; herdr integration install "${spec%%:*}" >/dev/null 2>&1 || log "herdr integration ${spec%%:*} failed"
done

envval() {  # envval KEY DEFAULT: a value from the provisioner's env file, re-read each time
  ( [ -f "$ENVF" ] && . "$ENVF" 2>/dev/null; v=${!1:-}; echo "${v:-$2}" )
}
ts() { tailscale --socket="$S/tailscaled.sock" "$@"; }

# ---- comebye + Serve. Both wait (in the background, so the idle clock below keeps
# running) for the provisioner's env file; Serve also waits for the node to be joined.
supervise_comebye() {
  until [ -f "$ENVF" ]; do sleep 2; done
  # SBX_* keys steer this script; the rest is comebye's own configuration.
  # shellcheck disable=SC1090
  set -a; . "$ENVF"; set +a
  # comebye's own HTTP client reaches the hub (a tailnet host) through tailscaled's SOCKS5.
  # Only comebye gets this, never herdr's panes (git/claude must go through the policy).
  local px=${SBX_HUB_PROXY-socks5h://127.0.0.1:1055}
  ( [ -n "$px" ] && export HTTPS_PROXY=$px HTTP_PROXY=$px NO_PROXY=127.0.0.1,localhost
    keep comebye comebye -addr 127.0.0.1:8741 -ts-socket "$S/tailscaled.sock"; wait )
}
supervise_comebye &

serve_up() {  # needs a joined node; idempotent (the Serve config persists in the state dir)
  until [ -f "$ENVF" ]; do sleep 2; done
  [ "$(envval SBX_SERVE 1)" = 1 ] || return 0
  local name
  while :; do
    # shellcheck disable=SC2016
    name=$(ts status --json 2>/dev/null | jq -r 'select(.BackendState=="Running") | .Self.DNSName // empty | rtrimstr(".")')
    [ -n "$name" ] && break; sleep 5
  done
  until ts serve --bg 8741 >>"$L/serve.log" 2>&1; do sleep 5; done
  # Warm-up: the first request pays for certificate issuance (~36 s, ACME via the proxy).
  until ts cert --cert-file=/dev/null --key-file=/dev/null "$name" >>"$L/serve.log" 2>&1; do sleep 10; done
  log "serve ready: https://$name"
}
serve_up &

# ---- Idle exit. "Busy" = SBX_IDLE_CMD exits 0 (if set; comebye's one-command idle
# check), else any herdr agent reporting agent_status "working". herdr up but silent
# also counts as busy: do not stop on a guess.
busy() {
  if [ -n "${SBX_IDLE_CMD:-}" ]; then bash -c "$SBX_IDLE_CMD" >/dev/null 2>&1; return; fi
  local out
  if out=$(herdr agent list 2>/dev/null); then grep -q '"agent_status":"working"' <<<"$out"
  else [ -S "$HOME/.config/herdr/herdr.sock" ]; fi
}
last=$(date +%s)
while sleep "$(envval SBX_TICK_SECONDS 300)"; do
  idle_min=$(envval SBX_IDLE_MINUTES 120); SBX_IDLE_CMD=$(envval SBX_IDLE_CMD "")
  if busy; then last=$(date +%s); continue; fi
  if (( $(date +%s) - last >= idle_min * 60 )); then log "idle $idle_min min: exiting 0"; exit 0; fi
done
