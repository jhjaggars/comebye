{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateNetworkAndDisksOnlyTaggedManagedBy",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc", "ec2:CreateInternetGateway", "ec2:CreateSubnet", "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup", "ec2:CreateVolume"
      ],
      "Resource": [
        "arn:aws:ec2:*:ACCOUNT_ID:vpc/*", "arn:aws:ec2:*:ACCOUNT_ID:internet-gateway/*", "arn:aws:ec2:*:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:*:ACCOUNT_ID:route-table/*", "arn:aws:ec2:*:ACCOUNT_ID:security-group/*", "arn:aws:ec2:*:ACCOUNT_ID:volume/*"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestTag/managed-by": "comebye-worker", "aws:RequestedRegion": ["us-east-1", "us-east-2", "us-west-2"] }
      }
    },
    {
      "Sid": "TheVpcAFreshSubnetOrGroupGoesIn",
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateSecurityGroup"],
      "Resource": "arn:aws:ec2:*:ACCOUNT_ID:vpc/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/managed-by": "comebye-worker", "aws:RequestedRegion": ["us-east-1", "us-east-2", "us-west-2"] }
      }
    },
    {
      "Sid": "RunInstancesOnlyTaggedAndOnlyTheAllowedFamilies",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*:ACCOUNT_ID:instance/*", "arn:aws:ec2:*:ACCOUNT_ID:volume/*", "arn:aws:ec2:*:ACCOUNT_ID:network-interface/*",
        "arn:aws:ec2:*:ACCOUNT_ID:spot-instances-request/*"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestTag/managed-by": "comebye-worker", "aws:RequestedRegion": ["us-east-1", "us-east-2", "us-west-2"] }
      }
    },
    {
      "Sid": "RunInstancesOnlyOfTheAllowedTypes",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringLike": { "ec2:InstanceType": ["t3.*", "t3a.*", "m5.*", "m6i.*", "c5.*", "c6i.*", "r5.*", "g4dn.*"] },
        "StringEquals": { "aws:RequestedRegion": ["us-east-1", "us-east-2", "us-west-2"] }
      }
    },
    {
      "Sid": "RunInstancesIntoOurSubnetAndGroupWithTheDebianImage",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": ["arn:aws:ec2:*:ACCOUNT_ID:subnet/*", "arn:aws:ec2:*:ACCOUNT_ID:security-group/*"],
      "Condition": {
        "StringEquals": { "aws:ResourceTag/managed-by": "comebye-worker", "aws:RequestedRegion": ["us-east-1", "us-east-2", "us-west-2"] }
      }
    },
    {
      "Sid": "TheMachineImage",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*::image/*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": ["us-east-1", "us-east-2", "us-west-2"] } }
    },
    {
      "Sid": "TagOnlyAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:*:ACCOUNT_ID:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": ["RunInstances", "CreateVpc", "CreateInternetGateway", "CreateSubnet", "CreateRouteTable", "CreateSecurityGroup", "CreateVolume"],
          "aws:RequestTag/managed-by": "comebye-worker"
        }
      }
    },
    {
      "Sid": "ChangeAndRemoveOnlyWhatCarriesTheTag",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances", "ec2:StopInstances", "ec2:TerminateInstances", "ec2:AttachVolume", "ec2:DeleteVolume",
        "ec2:AttachInternetGateway", "ec2:DetachInternetGateway", "ec2:DeleteInternetGateway",
        "ec2:CreateRoute", "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable", "ec2:DeleteRouteTable",
        "ec2:DeleteSubnet", "ec2:DeleteVpc", "ec2:AuthorizeSecurityGroupIngress", "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:*:ACCOUNT_ID:*/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/managed-by": "comebye-worker", "aws:RequestedRegion": ["us-east-1", "us-east-2", "us-west-2"] }
      }
    },
    {
      "Sid": "TheSpotRequestsOfOurOwnInstances",
      "Effect": "Allow",
      "Action": "ec2:CancelSpotInstanceRequests",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": ["us-east-1", "us-east-2", "us-west-2"] } }
    },
    {
      "Sid": "ReadTheBootLogForTheHostKey",
      "Effect": "Allow",
      "Action": "ec2:GetConsoleOutput",
      "Resource": "arn:aws:ec2:*:ACCOUNT_ID:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/managed-by": "comebye-worker" } }
    }
  ]
}
