{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEC2InOneRegion",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeSpotPriceHistory",
        "ec2:GetSpotPlacementScores",
        "ec2:DescribeInstances",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeImages",
        "ec2:DescribeSpotInstanceRequests"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": ["us-east-1", "us-east-2", "us-west-2"] } }
    },
    {
      "Sid": "ReadPriceList",
      "Effect": "Allow",
      "Action": "pricing:GetProducts",
      "Resource": "*"
    },
    {
      "Sid": "ReadDebianAmiParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": [
        "arn:aws:ssm:us-east-1::parameter/aws/service/debian/release/12/latest/amd64",
        "arn:aws:ssm:us-east-1::parameter/aws/service/debian/release/12/latest/arm64",
        "arn:aws:ssm:us-east-2::parameter/aws/service/debian/release/12/latest/amd64",
        "arn:aws:ssm:us-east-2::parameter/aws/service/debian/release/12/latest/arm64",
        "arn:aws:ssm:us-west-2::parameter/aws/service/debian/release/12/latest/amd64",
        "arn:aws:ssm:us-west-2::parameter/aws/service/debian/release/12/latest/arm64"
      ]
    }
  ]
}
