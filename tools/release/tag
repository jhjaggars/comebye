#!/usr/bin/env bash
# Tag a comebye release and push just that tag, which starts the Release workflow.
#
#   tools/release/tag VERSION [COMMIT] [--yes] [--dry-run] [--check]
#
#   tools/release/tag v0.5.9                  # tip of origin/main
#   tools/release/tag v0.5.9 6acddb6 --dry-run
#
# Checks first (and refuses): VERSION is vMAJOR.MINOR.PATCH and newer than the
# latest v* tag, the tag exists nowhere, COMMIT is on origin/main, CI passed on
# COMMIT. Works from any checkout or worktree of the repository.
#
# --check changes nothing and prints key=value lines for the Comebye app (the
# server runs this same script for its release page): commit, short, subject,
# previous, ci_id, ci_status, ci_conclusion, ci_url, change (one per commit),
# then ok=1, or problem=<why> in place of ok (the exit status is 0 either way).
# COMEBYE_RELEASE_REPO names the checkout to work in (the server sets it; it
# also runs the script from its own copy).
set -euo pipefail

if [ -n "${COMEBYE_RELEASE_REPO:-}" ]; then
  root="$COMEBYE_RELEASE_REPO"
else
  root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi
cd "$root"

check=0
die() {
  if [ "$check" = 1 ]; then echo "problem=$*"; exit 0; fi
  echo "tag: $*" >&2; exit 1
}
usage() { sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }

yes=0 dry=0 args=()
for a in "$@"; do
  case "$a" in
    --yes|-y) yes=1 ;;
    --dry-run|-n) dry=1 ;;
    --check) check=1 ;;
    -h|--help) usage 0 ;;
    -*) echo "tag: unknown option $a" >&2; usage ;;
    *) args+=("$a") ;;
  esac
done
[ "${#args[@]}" -ge 1 ] && [ "${#args[@]}" -le 2 ] || usage
version="${args[0]}"
want="${args[1]:-origin/main}"

[[ "$version" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] ||
  die "$version is not vMAJOR.MINOR.PATCH (e.g. v0.5.9)"
command -v gh >/dev/null || die "the gh CLI is required for the CI check"

# Work only with the project's own repository, whatever the checkout's local
# configuration says: gh is pinned to it, hooks and fsmonitor are off, and
# origin (fetch and push, after any url.*.insteadOf rewriting) must be it.
slug="${COMEBYE_RELEASE_SLUG:-jhjaggars/comebye}"
export GH_REPO="$slug"
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null GIT_CONFIG_KEY_1=core.fsmonitor GIT_CONFIG_VALUE_1=false
for u in "$(git ls-remote --get-url origin 2>/dev/null)" "$(git remote get-url --push origin 2>/dev/null)"; do
  case "$u" in
    "https://github.com/$slug"|"https://github.com/$slug.git"|"git@github.com:$slug"|"git@github.com:$slug.git"|"ssh://git@github.com/$slug"|"ssh://git@github.com/$slug.git") ;;
    "${COMEBYE_RELEASE_ORIGIN:-/nonexistent}") ;;   # tests: a local stand-in for GitHub
    *) die "origin is ${u:-unset}, not github.com/$slug: use a dedicated clone of the project" ;;
  esac
done

git fetch origin --tags --quiet || die "git fetch origin failed"

sha="$(git rev-parse --verify --quiet "$want^{commit}")" || die "no such commit: $want"
short="$(git rev-parse --short "$sha")"
if [ "$check" = 1 ]; then
  echo "commit=$sha"
  echo "short=$short"
  echo "subject=$(git log -1 --format=%s "$sha" | tr -d '\n\r')"
fi

# The tags that count are origin's: a tag planted in the checkout changes nothing.
rtags="$(git ls-remote --tags --refs origin 'refs/tags/v*')" || die "could not list the tags on origin"
rtags="$(printf '%s\n' "$rtags" | sed 's|.*refs/tags/||' | grep -E '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || true)"
if printf '%s\n' "$rtags" | grep -qx "$version"; then
  die "tag $version already exists on origin"
fi
# A tag left here by a push that failed points at this commit and is not on
# origin: it is replaced, so the failed try can be repeated.
stale=0
if git rev-parse --verify --quiet "refs/tags/$version" >/dev/null; then
  if [ "$(git rev-parse "refs/tags/$version^{commit}")" = "$sha" ]; then
    stale=1
  else
    die "tag $version already exists locally, at another commit"
  fi
fi

prev="$(printf '%s\n' "$rtags" | sort -V | tail -n1)"
if [ -n "$prev" ]; then
  top="$(printf '%s\n%s\n' "$prev" "$version" | sort -V | tail -n1)"
  [ "$top" = "$version" ] || die "$version is not greater than the latest tag $prev"
fi

[ "$check" = 1 ] && echo "previous=$prev"
git merge-base --is-ancestor "$sha" origin/main ||
  die "commit $short is not on origin/main"

# CI: the newest run of the CI workflow for this commit must have succeeded.
runs="$(gh run list --commit "$sha" --workflow CI --limit 1 \
  --json databaseId,status,conclusion,url \
  --jq '.[] | "\(.databaseId) \(.status) \(.conclusion) \(.url)"')" ||
  die "could not list CI runs (is gh authenticated?)"
[ -n "$runs" ] || die "no CI run found for $short; wait for CI to start or push the commit"
read -r ci_id ci_status ci_conclusion ci_url <<<"$runs"
if [ "$check" = 1 ]; then
  echo "ci_id=$ci_id"; echo "ci_status=$ci_status"; echo "ci_conclusion=$ci_conclusion"; echo "ci_url=$ci_url"
fi
if [ "$ci_status" != completed ]; then
  die "CI for $short is still $ci_status: $ci_url"
elif [ "$ci_conclusion" != success ]; then
  die "CI for $short finished with $ci_conclusion: $ci_url"
fi

if [ "$check" = 1 ]; then
  git log --format='change=%h %s' --max-count=200 "${prev:+$prev..}$sha" | tr -d '\r'
  echo "ok=1"
  exit 0
fi

echo "Commit:   $short $(git log -1 --format=%s "$sha")"
echo "Previous: ${prev:-(none)}"
echo "CI run:   $ci_id ($ci_url)"
echo "Changes since ${prev:-the start}:"
git log --oneline "${prev:+$prev..}$sha" | sed 's/^/  /' || true

sign=-a kind=annotated
if [ "$(git config --type=bool --get tag.gpgSign || true)" = true ] || [ -n "$(git config --get user.signingkey || true)" ]; then
  sign=-s kind=signed
fi

if [ "$dry" = 1 ]; then
  echo
  echo "Dry run. Would run:"
  echo "  git tag $sign -m $version $version $sha   ($kind)"
  echo "  git push origin refs/tags/$version"
  exit 0
fi

if [ "$yes" != 1 ]; then
  printf 'Tag and push? [y/N] '
  read -r ans || ans=
  case "$ans" in y|Y|yes|YES) ;; *) echo "Not tagged."; exit 1 ;; esac
fi

[ "$stale" = 1 ] && git tag -d "$version" >/dev/null
git tag "$sign" -m "$version" "$version" "$sha"
if ! git push origin "refs/tags/$version"; then
  git tag -d "$version" >/dev/null 2>&1 || true   # so the next try is not blocked by it
  die "git push of $version failed; nothing was pushed"
fi
echo "Pushed $version ($kind) at $short."

# The Release workflow run for the new tag appears a few seconds later.
for _ in $(seq 1 12); do
  url="$(gh run list --workflow Release --branch "$version" --limit 1 \
    --json url --jq '.[0].url // empty' 2>/dev/null || true)"
  if [ -n "$url" ]; then echo "Release workflow: $url"; exit 0; fi
  sleep 5
done
echo "Release workflow not visible yet; see https://github.com/jhjaggars/comebye/actions/workflows/release.yml"
